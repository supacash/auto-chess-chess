{
  // Typechecks the Node scripts (simulator) together with the game code they import.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": ["sim/**/*.ts", "../src/**/*.ts"],
  // The root config leaves tests out of the browser typecheck (they use Node APIs); check them here.
  "exclude": []
}
