{
  "name": "auto-chess-chess",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build-engine": "node scripts/build-engine.mjs",
    "predev": "npm run build-engine",
    "dev": "vite",
    "dev:fairy": "npm run build-engine && vite --mode fairy",
    "prebuild": "npm run build-engine",
    "build": "tsc --noEmit && vite build",
    "build:fairy": "npm run build-engine && tsc --noEmit && vite build --mode fairy",
    "preview": "vite preview",
    "android": "npm run build && cap sync android",
    "android:open": "cap open android",
    "pretypecheck": "npm run build-engine",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "pretest": "npm run build-engine",
    "test": "vitest run",
    "engine:check": "cd engine && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked",
    "sim": "tsx scripts/sim/sim.ts",
    "sim:duel": "tsx scripts/sim/duel.ts",
    "sim:synergy": "tsx scripts/sim/synergyDuel.ts",
    "sim:ai-synergies": "tsx scripts/sim/aiSynergies.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:determinism": "tsx scripts/check/determinism.ts",
    "e2e": "playwright test",
    "e2e:fairy": "playwright test --config playwright.fairy.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project auto-chess-chess \"vitest run --config vitest.rules.config.ts\"",
    "e2e:online": "firebase emulators:exec --only auth,firestore --project auto-chess-chess \"playwright test --config playwright.online.config.ts\"",
    "e2e:fullmatch": "firebase emulators:exec --only auth,firestore --project auto-chess-chess \"playwright test --config playwright.fullmatch.config.ts\"",
    "check:baseline": "tsx scripts/check/baseline.ts",
    "check:perft": "tsx scripts/check/perft.ts",
    "sim:arena": "tsx scripts/sim/arena.ts",
    "sim:starts": "tsx scripts/sim/starts.ts",
    "check:depth": "tsx scripts/check/depth.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "coi-serviceworker": "^0.1.7",
    "fairy-stockfish-nnue.wasm": "^1.1.12",
    "ffish-es6": "^0.7.10",
    "firebase-tools": "^15.33.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "firebase": "^12.19.0"
  }
}
