{
  "name": "auto-chess-chess",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "copy-engine": "node scripts/copy-engine.mjs",
    "predev": "npm run copy-engine",
    "dev": "vite",
    "prebuild": "npm run copy-engine",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "sim": "tsx scripts/sim/sim.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "coi-serviceworker": "^0.1.7",
    "fairy-stockfish-nnue.wasm": "^1.1.12",
    "ffish-es6": "^0.7.10"
  }
}
